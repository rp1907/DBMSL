SELECT S.NAME, E.COURSE, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID;

SELECT S.NAME, E.COURSE, E.MARKS
FROM STUDENTS S
LEFT JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID;

SELECT E.*, S.NAME
FROM ENROLLMENTS E
INNER JOIN STUDENTS S
ON E.STUDENT_ID = S.STUDENT_ID;

SELECT S.NAME, E.COURSE
FROM STUDENTS S
CROSS JOIN ENROLLMENTS E;

SELECT S.NAME, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID
WHERE E.MARKS > (
    SELECT AVG(MARKS)
    FROM ENROLLMENTS
);

SELECT S.NAME, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID
WHERE E.MARKS > 80;

SELECT S.NAME, E.COURSE, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID
WHERE E.COURSE = 'DBMS';

SELECT STUDENT_ID
FROM ENROLLMENTS
WHERE MARKS = (
    SELECT MAX(MARKS)
    FROM ENROLLMENTS
);

CREATE VIEW STUDENT_COURSE_VIEW AS
SELECT S.NAME, E.COURSE, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID;

SELECT * FROM STUDENT_COURSE_VIEW;

