SELECT S.NAME, E.COURSE
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID;

SELECT S.*, E.COURSE, E.MARKS
FROM STUDENTS S
LEFT JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID;

SELECT S.NAME, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID
WHERE E.COURSE = 'DBMS';

SELECT E.*
FROM ENROLLMENTS E
LEFT JOIN STUDENTS S
ON E.STUDENT_ID = S.STUDENT_ID
WHERE S.STUDENT_ID IS NULL;

SELECT S.NAME, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID
WHERE E.MARKS < (
    SELECT AVG(MARKS)
    FROM ENROLLMENTS
);

SELECT S.NAME, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID
WHERE E.MARKS = (
    SELECT MAX(MARKS)
    FROM ENROLLMENTS
);

SELECT *
FROM STUDENTS
WHERE CITY = 'PUNE';

SELECT S.NAME, E.COURSE, E.MARKS
FROM STUDENTS S
INNER JOIN ENROLLMENTS E
ON S.STUDENT_ID = E.STUDENT_ID
WHERE E.COURSE = 'PYTHON';

CREATE VIEW COURSE_AVERAGE_VIEW AS
SELECT COURSE, AVG(MARKS) AS AVERAGE_MARKS
FROM ENROLLMENTS
GROUP BY COURSE;

SELECT * FROM COURSE_AVERAGE_VIEW;

