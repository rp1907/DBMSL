CREATE OR REPLACE TRIGGER LIBRARY_TRIGGER

BEFORE UPDATE OR DELETE ON LIBRARY

FOR EACH ROW

BEGIN

    IF UPDATING THEN

        INSERT INTO LIBRARY_AUDIT
        VALUES (
            :OLD.BOOK_ID,
            :OLD.BOOK_NAME,
            :OLD.AUTHOR,
            :OLD.CATEGORY,
            :OLD.BOOK_DATE,
            'UPDATE'
        );

    ELSIF DELETING THEN

        INSERT INTO LIBRARY_AUDIT
        VALUES (
            :OLD.BOOK_ID,
            :OLD.BOOK_NAME,
            :OLD.AUTHOR,
            :OLD.CATEGORY,
            :OLD.BOOK_DATE,
            'DELETE'
        );

    END IF;

END;
/

