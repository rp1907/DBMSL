CREATE TABLE LIBRARY (
    BOOK_ID INT PRIMARY KEY,
    BOOK_NAME VARCHAR(50),
    AUTHOR VARCHAR(50),
    CATEGORY VARCHAR(30),
    BOOK_DATE DATE,
    OPERATION VARCHAR(20)
);

