SELECT *
FROM CUSTOMER
ORDER BY CUST_NAME ASC;

SELECT CUST_NAME, CITY
FROM CUSTOMER
WHERE CUST_NAME LIKE 'P%';

SELECT *
FROM CUSTOMER
WHERE CITY IN ('PUNE','MUMBAI')
AND PHONE IS NOT NULL;

SELECT *
FROM CUSTOMER
WHERE PHONE IS NULL;

SELECT BRANCH_ID, AVG(BALANCE) AS AVG_BALANCE
FROM ACCOUNT
GROUP BY BRANCH_ID;

SELECT BRANCH_ID, AVG(BALANCE) AS AVG_BALANCE
FROM ACCOUNT
GROUP BY BRANCH_ID
HAVING AVG(BALANCE) > 40000;

SELECT ACC_NO, BALANCE,
BALANCE + (BALANCE * 10 / 100) AS NEW_BALANCE
FROM ACCOUNT;

