CREATE TABLE AREAS (
    RADIUS INT,
    AREA DECIMAL(10,2)
);

CREATE OR REPLACE FUNCTION CAL_AREA(R INT)
RETURN NUMBER
IS
    A NUMBER;
BEGIN
    A := 3.14 * R * R;

    RETURN A;
END;
/



BEGIN

    DELETE FROM AREAS;

    FOR I IN 5..9
    LOOP
        INSERT INTO AREAS VALUES(I, CAL_AREA(I));
    END LOOP;

    COMMIT;

END;
/


SELECT * FROM AREAS;
