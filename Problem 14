DELETE FROM CUSTOMER
WHERE PHONE IS NULL;

SELECT * FROM CUSTOMER;

SELECT CUST_ID, CUST_NAME
FROM CUSTOMER
WHERE CUST_ID IN (
    SELECT CUST_ID FROM ACCOUNT

    INTERSECT

    SELECT CUST_ID FROM LOAN
);

SELECT CUST_ID, CUST_NAME
FROM CUSTOMER C
WHERE EXISTS (
    SELECT 1
    FROM ACCOUNT A
    WHERE A.CUST_ID = C.CUST_ID
)
AND NOT EXISTS (
    SELECT 1
    FROM LOAN L
    WHERE L.CUST_ID = C.CUST_ID
);

SELECT CUST_ID, CUST_NAME
FROM CUSTOMER
WHERE CUST_ID IN (
    SELECT CUST_ID FROM ACCOUNT
    MINUS
    SELECT CUST_ID FROM LOAN
);

