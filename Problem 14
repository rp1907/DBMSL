SELECT *
FROM CUSTOMER
WHERE CITY IN ('PUNE','MUMBAI')
ORDER BY CUST_NAME ASC;

SELECT CUST_NAME
FROM CUSTOMER
WHERE CUST_NAME LIKE '%A%';

SELECT *
FROM CUSTOMER
WHERE PHONE IS NOT NULL;

SELECT *
FROM CUSTOMER
WHERE (CITY = 'PUNE' AND CUST_NAME LIKE 'P%')
OR CITY = 'MUMBAI';

SELECT BRANCH_ID,
MAX(AMOUNT) AS MAX_LOAN,
AVG(AMOUNT) AS AVG_LOAN
FROM LOAN
GROUP BY BRANCH_ID;

SELECT BRANCH_ID,
SUM(AMOUNT) AS TOTAL_LOAN
FROM LOAN
GROUP BY BRANCH_ID
HAVING SUM(AMOUNT) > 100000;

SELECT ACC_NO,
BALANCE,
BALANCE + 500 AS NEW_BALANCE
FROM ACCOUNT;

